# ============================================================
# КТК ЭЛОУ-АВ — Файл переменных окружения
# ============================================================
# Скопируйте этот файл в .env и заполните значениями:
#   cp .env.example .env
# ============================================================

# --- Режим запуска ---
# dev  — без проверки JWT, in-memory хранилище (быстрый старт)
# prod — полная авторизация через Keycloak, проверка JWT
SPRING_PROFILES_ACTIVE=prod

# --- Публичные URL (доступны из браузера клиента) ---
# Используются фронтендом (VITE_*) и Keycloak (redirect URIs)
# Для локального запуска: http://localhost:3000 / http://localhost:8080 / http://localhost:8180
# Для прод-сервера:      https://elouav.example.ru / https://api.elouav.example.ru / https://auth.elouav.example.ru
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8080
PUBLIC_KEYCLOAK_URL=http://localhost:8180

# --- Vite env (вшиваются в JS-бандл при сборке фронтенда) ---
VITE_API_BASE=/api
VITE_KEYCLOAK_URL=http://localhost:8180/realms/elouav
VITE_REDIRECT_URI=http://localhost:3000/callback

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=elouav
DB_USER=elouav
DB_PASS=elouav_dev

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Keycloak ---
KC_HOSTNAME=localhost
KC_HTTP_PORT=8180
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_HTTP_ENABLED=true
KC_REALM=elouav

# --- Backend → Keycloak (внутренний URL в Docker-сети) ---
KEYCLOAK_URL=http://keycloak:8180

# --- Backend JVM ---
JAVA_OPTS=-Xmx256m

# --- ИИ: LLM-судья (OpenAI-compatible API) ---
# Поддерживает: OpenAI, vLLM, Ollama, LM Studio, GPT4All
# Ollama пример:   LLM_ENDPOINT=http://localhost:11434  LLM_MODEL=qwen2.5-7b
# vLLM пример:     LLM_ENDPOINT=http://gpu-server:8000  LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# OpenAI пример:   LLM_ENDPOINT=https://api.openai.com  LLM_MODEL=gpt-4o-mini  LLM_API_KEY=sk-...
LLM_ENDPOINT=http://localhost:11434
LLM_API_KEY=test-key
LLM_MODEL=gpt-4o-mini

# --- Тестовые пользователи Keycloak (создаются при импорте realm) ---
# Меняются в keycloak-config/realm-export.json перед первым запуском
STUDENT_PASSWORD=student
INSTRUCTOR_PASSWORD=instructor
METHODIST_PASSWORD=methodist
ADMIN_PASSWORD=admin

# --- Порты хоста (маппинг из Docker) ---
PORT_FRONTEND=3000
PORT_BACKEND=8080
PORT_KEYCLOAK=8180
PORT_POSTGRES=5432
PORT_REDIS=6379

# --- Логирование ---
LOG_LEVEL=DEBUG
