{
  "realm": "elouav",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "student", "description": "Обучающийся" },
      { "name": "instructor", "description": "Преподаватель" },
      { "name": "methodist", "description": "Методист" },
      { "name": "admin", "description": "Администратор" }
    ]
  },
  "groups": [
    { "name": "students", "realmRoles": ["student"] },
    { "name": "instructors", "realmRoles": ["instructor"] },
    { "name": "methodists", "realmRoles": ["methodist"] },
    { "name": "admins", "realmRoles": ["admin"] }
  ],
  "users": [
    {
      "username": "student",
      "enabled": true,
      "email": "student@elouav.local",
      "firstName": "Иван",
      "lastName": "Студентов",
      "credentials": [
        { "type": "password", "value": "student", "temporary": false }
      ],
      "realmRoles": ["student"],
      "groups": ["students"]
    },
    {
      "username": "instructor",
      "enabled": true,
      "email": "instructor@elouav.local",
      "firstName": "Светлана",
      "lastName": "Преподавателева",
      "credentials": [
        { "type": "password", "value": "instructor", "temporary": false }
      ],
      "realmRoles": ["instructor"],
      "groups": ["instructors"]
    },
    {
      "username": "methodist",
      "enabled": true,
      "email": "methodist@elouav.local",
      "firstName": "Кирилл",
      "lastName": "Методистов",
      "credentials": [
        { "type": "password", "value": "methodist", "temporary": false }
      ],
      "realmRoles": ["methodist"],
      "groups": ["methodists"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@elouav.local",
      "firstName": "Админ",
      "lastName": "Админов",
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": ["admin"],
      "groups": ["admins"]
    }
  ],
  "clients": [
    {
      "clientId": "elouav-frontend",
      "name": "КТК ЭЛОУ-АВТ Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "https://localhost:3000/*",
        "https://localhost:5173/*",
        "https://it-camp-2026.ru/*",
        "https://www.it-camp-2026.ru/*",
        "https://*/*"
      ],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173", "https://it-camp-2026.ru", "https://api.it-camp-2026.ru", "https://*", "*"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "preferred_username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "elouav-backend",
      "name": "КТК ЭЛОУ-АВТ Backend",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ]
}
